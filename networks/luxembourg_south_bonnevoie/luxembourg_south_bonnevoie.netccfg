<?xml version='1.0' encoding='UTF-8'?>
<netconvertConfiguration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/netconvertConfiguration.xsd">
    <input>
        <node-files value="out/luxembourg_south_bonnevoie.nod.xml" />
        <edge-files value="out/luxembourg_south_bonnevoie.edg.xml" />
        <connection-files value="out/luxembourg_south_bonnevoie.con.xml" />
        <tllogic-files value="out/luxembourg_south_bonnevoie.tll.xml" />
        <type-files value="luxembourg_south_bonnevoie.typ.xml" />
    </input>
    <output>
        <output-file value="out/luxembourg_south_bonnevoie.net.xml" />
    </output>
    <processing>
        <geometry.remove value="false" />
        <geometry.min-radius.fix.railways value="false" />
        <geometry.avoid-overlap value="false" />
        <geometry.max-grade.fix value="false" />
        <offset.disable-normalization value="true" />
    </processing>
    <edge_removal>
        <keep-edges.input-file value="in/edges_to_keep.txt" />
        <keep-edges.components value="1" />
    </edge_removal>
    <junctions>
        <no-internal-links value="false" />
        <no-turnarounds value="true" />
        <junctions.join value="false" />
        <junctions.corner-detail value="0" />
        <junctions.limit-turn-speed value="-1.00" />
    </junctions>
</netconvertConfiguration>